</div>

<script>
(() => {
'use strict';
const W = 900, H = 600, GW = 900, GH = 240;
const base = { x: 450, y: 300 }, T0 = 135, T1 = 0.35, SPEED = 7.5;
const SANS = '"Hiragino Sans","Hiragino Kaku Gothic ProN","Yu Gothic","Noto Sans JP",Meiryo,sans-serif';
const MONO = 'ui-monospace,"SF Mono",Menlo,Consolas,monospace';
const $ = s => document.querySelector(s);

let pts = [], phase = 'idle', raf = 0, score = { a: 0, b: 0, d: 0 }, arrivals = 0, clock = 0, scored = false, intro = true;

const DPR = Math.min(window.devicePixelRatio || 1, 2);
function sized(c) {
  c.width = c.width * DPR;
  c.height = c.height * DPR;
  const x = c.getContext('2d');
  x.setTransform(DPR, 0, 0, DPR, 0, 0);
  return x;
}
function makeCanvas(w, h) {
  const c = document.createElement('canvas');
  c.width = w; c.height = h;
  return { c, x: sized(c) };
}

const lanes = ['a', 'b'].map(id => {
  const c = $('#c' + id);
  c.width = W; c.height = H;
  const g = makeCanvas(W, H);
  return {
    id, c, x: sized(c), ghost: g.c, gx: g.x,
    route: null, best: null, cum: null, d: 0, T: 0, sparks: [], trail: [], hist: [], histDone: false, arrived: false, rank: 0, iter: 0
  };
});
const gc = $('#cg');
gc.width = GW; gc.height = GH;
const gx = sized(gc);

const nodes = () => [base, ...pts];
const dist = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);
const len = (r, ns) => {
  let t = 0;
  for (let i = 0; i < r.length; i++) t += dist(ns[r[i]], ns[r[(i + 1) % r.length]]);
  return t;
};
const msg = t => { $('#msg').innerHTML = t; };
const shown = v => Math.round(v).toLocaleString('ja-JP');

function combo() {
  const n = pts.length + 1;
  if (n < 3) return '1 通り';
  let f = 1n;
  for (let i = 2n; i < BigInt(n); i++) f *= i;
  const s = (f / 2n).toString();
  return s.length > 9
    ? `約 ${s[0]}.${s[1]} × 10<sup>${s.length - 1}</sup> 通り`
    : Number(s).toLocaleString('ja-JP') + ' 通り';
}

function showScore() {
  const tot = score.a + score.b + score.d;
  $('#score').textContent = tot
    ? `SCORE（この配置での通算成績）   CASE A: ${score.a}勝  /  CASE B: ${score.b}勝  /  DRAW: ${score.d}`
    : '';
}

function setStep(n) {
  [1, 2, 3].forEach(i => {
    const el = $('#step-' + i);
    el.classList.toggle('active', i === n);
    el.classList.toggle('done', i < n);
  });
}

function updatePresetButtons(activeN) {
  document.querySelectorAll('[data-n]').forEach(b => {
    b.classList.toggle('active-preset', Number(b.dataset.n) === activeN);
  });
}

function syncButtons() {
  const busy = phase === 'search' || phase === 'run';
  const ok = pts.length >= 3;

  $('#preset-group').classList.toggle('highlight-group', pts.length === 0);
  $('#hint-a').classList.toggle('hidden', pts.length > 0);
  $('#hint-b').classList.toggle('hidden', pts.length > 0);

  $('#calc').disabled = busy || !ok;
  $('#calc').classList.toggle('ready-pulse', phase === 'idle' && ok);
  $('#calc').textContent = phase === 'search' ? 'ルートを計算中...'
    : (phase === 'calculated' || phase === 'done' ? '① 再計算する' : '① ルートを計算');

  $('#go').disabled = busy || (phase !== 'calculated' && phase !== 'done');
  $('#go').textContent = phase === 'run' ? 'サンタ走行中...'
    : (phase === 'done' ? '② もう一度走る' : '② スタート（競争開始）');
  $('#go').classList.toggle('ready-pulse', phase === 'calculated');

  $('#undo').disabled = busy || pts.length === 0;
  $('#clr').disabled = busy || pts.length === 0;
  document.querySelectorAll('[data-n]').forEach(b => { b.disabled = busy; });
}

function clearGhost(L) { L.gx.clearRect(0, 0, W, H); }

function reset(keepScore) {
  cancelAnimationFrame(raf);
  phase = 'idle';
  scored = false;
  if (!keepScore) score = { a: 0, b: 0, d: 0 };
  lanes.forEach(L => {
    L.route = L.best = L.cum = null;
    L.d = 0; L.T = 0; L.iter = 0; L.sparks = []; L.trail = []; L.hist = []; L.histDone = false; L.arrived = false; L.rank = 0;
    clearGhost(L);
    $('#lane-' + L.id).classList.remove('winner');
  });
  $('#combo').innerHTML = pts.length ? `家${pts.length}軒 → ${combo()}` : '—';
  showScore();
  setStep(pts.length < 3 ? 1 : 2);
  syncButtons();
  ui();
  lanes.forEach(draw);
  drawGraph();

  if (pts.length === 0) {
    msg('<b>家を置いてください。</b>黒い地図をクリックすると、配達先の家が増えます。「家の数を変える」で、まとめて置くこともできます（3軒以上で計算できます）。');
  } else if (pts.length < 3) {
    msg(`いま ${pts.length}軒。あと <b>${3 - pts.length}軒</b> 置くと、ルート計算ができます。`);
  } else if (intro) {
    intro = false;
    msg('<b>はじめに。</b>サンタは、金色の菱形（横浜）を出発し、白い点の家をすべて1回ずつ回って戻ります。見本の14軒を置きました。<b>「① ルートを計算」</b>を押すと、AとBが同じ出発ルートから、短い道順を探し始めます。');
  } else {
    msg(`家は ${pts.length}軒。<b>「① ルートを計算」</b>を押して、AとBの探し方の違いを見てみましょう。`);
  }
}

function scatter(n) {
  pts = [];
  if (n === 8) {
    const pattern = [
      { x: 450, y: 120 }, { x: 450, y: 215 }, { x: 700, y: 210 }, { x: 575, y: 265 },
      { x: 640, y: 470 }, { x: 515, y: 390 }, { x: 230, y: 440 }, { x: 260, y: 200 }
    ];
    pts = pattern.map(p => ({ x: p.x + (Math.random() - 0.5) * 26, y: p.y + (Math.random() - 0.5) * 26 }));
  } else {
    const clusters = [
      { cx: 210, cy: 155, r: 95 }, { cx: 700, cy: 165, r: 95 }, { cx: 710, cy: 445, r: 95 },
      { cx: 200, cy: 445, r: 95 }, { cx: 450, cy: 135, r: 75 }, { cx: 450, cy: 470, r: 75 }
    ];
    let guard = 0;
    const minDist = n > 16 ? 44 : 56;
    while (pts.length < n && guard++ < 6000) {
      const c = clusters[pts.length % clusters.length];
      const ang = Math.random() * Math.PI * 2;
      const rad = Math.random() * c.r;
      const p = {
        x: Math.max(54, Math.min(W - 54, c.cx + Math.cos(ang) * rad)),
        y: Math.max(54, Math.min(H - 54, c.cy + Math.sin(ang) * rad))
      };
      if (dist(p, base) > 74 && pts.every(q => dist(p, q) > minDist)) pts.push(p);
    }
  }
  updatePresetButtons(n);
  reset(false);
}

function cumOf(r, ns) {
  const c = [0];
  for (let i = 0; i < r.length; i++) c.push(c[i] + dist(ns[r[i]], ns[r[(i + 1) % r.length]]));
  return c;
}

function posAt(L, ns, d) {
  const c = L.cum, r = L.best;
  let k = 0;
  while (k < r.length - 1 && c[k + 1] < d) k++;
  const a = ns[r[k]], b = ns[r[(k + 1) % r.length]], s = c[k + 1] - c[k] || 1;
  const t = Math.min(1, (d - c[k]) / s);
  return { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t };
}

function startCalculation() {
  if (pts.length < 3 || phase === 'search' || phase === 'run') return;
  const ns = nodes(), n = ns.length;

  // AとBに同じ出発ルートを渡す（ランダムに作った20本のうち、いちばん長いもの）
  let first = null, firstD = -1;
  for (let trial = 0; trial < 20; trial++) {
    const rest = [...Array(n - 1)].map((_, i) => i + 1);
    for (let i = rest.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [rest[i], rest[j]] = [rest[j], rest[i]];
    }
    const cand = [0, ...rest], d = len(cand, ns);
    if (d > firstD) { firstD = d; first = cand; }
  }

  const tot = 2600 + 480 * pts.length;
  scored = false;

  lanes.forEach(L => {
    L.ns = ns;
    L.route = first.slice();
    L.best = first.slice();
    L.cur = L.bestD = firstD;
    L.iter = 0; L.stale = 0; L.done = false; L.arrived = false; L.d = 0; L.cum = null;
    L.sparks = []; L.trail = []; L.total = tot;
    L.hist = [{ x: 0, y: firstD }]; L.histDone = false;
    L.T = L.id === 'b' ? T0 : 0;
    clearGhost(L);
    $('#lane-' + L.id).classList.remove('winner');
  });

  phase = 'search';
  setStep(2);
  syncButtons();
  msg('<b>ルートを計算中...</b> 右のBでは、赤い破線が長くなる変更も試しながら動き回り、温度が下がるにつれて、緑の最良ルートに落ち着いていきます。左のAは、短くなる変更だけを採用します。下のグラフで、長さの変化も見られます。');
  raf = requestAnimationFrame(tick);
}

function startRace() {
  if (phase !== 'calculated' && phase !== 'done') return;
  arrivals = 0;
  lanes.forEach(L => {
    L.d = 0; L.arrived = false; L.rank = 0; L.trail = [];
    L.cum = cumOf(L.best, L.ns);
    $('#lane-' + L.id).classList.remove('winner');
  });
  phase = 'run';
  setStep(3);
  syncButtons();
  msg('<b>競争スタート！</b>計算で見つけたそれぞれの最良ルートを、光のサンタが走ります。総距離が短い方が、先に横浜へ帰ってきます。');
  raf = requestAnimationFrame(tick);
}

// AとBは同じ種類の入れ替え（2-opt 72% / 1点移動 28%）を使う。違うのは、採用のルールだけ。
function propose(L) {
  const r = L.route, n = r.length;
  const c = r.slice();
  let pivot = 1;

  if (Math.random() < 0.72) {
    const i = 1 + Math.floor(Math.random() * (n - 2));
    const j = i + 1 + Math.floor(Math.random() * (n - i - 1));
    for (let a = i, b = j; a < b; a++, b--) { const t = c[a]; c[a] = c[b]; c[b] = t; }
    pivot = i;
  } else {
    const from = 1 + Math.floor(Math.random() * (n - 1));
    const to = 1 + Math.floor(Math.random() * (n - 1));
    const [item] = c.splice(from, 1);
    c.splice(to, 0, item);
    pivot = to;
  }

  const d = len(c, L.ns), delta = d - L.cur;
  L.iter++;

  let take;
  if (L.id === 'a') {
    take = delta < -1e-9;
  } else {
    L.T = T0 * Math.pow(T1 / T0, Math.min(1, L.iter / L.total));
    take = delta < 0 || Math.random() < Math.exp(-delta / L.T);
  }

  if (take) {
    L.route = c;
    L.cur = d;
    L.stale = 0;
    if (d < L.bestD - 1e-9) {
      L.bestD = d;
      L.best = c.slice();
      const pt = L.ns[c[pivot]];
      if (L.sparks.length < 18) L.sparks.push({ x: pt.x, y: pt.y, life: 1 });
    }
  } else {
    L.stale++;
  }

  if (L.id === 'a' ? L.stale >= n * n * 8 : L.iter >= L.total) {
    L.done = true;
    L.route = L.best.slice();
    L.cur = L.bestD;
    L.T = 0;
  }
}

function finishRace() {
  phase = 'done';
  const a = lanes[0].bestD, b = lanes[1].bestD, diff = (a - b) / a * 100;
  syncButtons();

  if (Math.abs(diff) < 0.4) {
    if (!scored) score.d++;
    msg('<b>引き分け。</b>AとBは、ほぼ同じ長さの道順を見つけました。「① 再計算する」や、家の数を変えて、もう一度試してみてください。');
  } else if (diff > 0) {
    if (!scored) score.b++;
    $('#lane-b').classList.add('winner');
    msg(`<b>CASE B の勝ち。</b>長くなる変更も受け入れたBは、Aより <b>${diff.toFixed(1)}% 短い</b>道順を見つけました。`);
  } else {
    if (!scored) score.a++;
    $('#lane-a').classList.add('winner');
    msg(`<b>今回は CASE A の勝ち。</b>Aのほうが ${(-diff).toFixed(1)}% 短くなりました。焼きなまし法でも、必ず勝つわけではありません。「① 再計算する」で、何度か比べてみてください。`);
  }
  scored = true;
  showScore();
}

function polyOn(c, r, ns, close) {
  c.beginPath();
  r.forEach((k, i) => i ? c.lineTo(ns[k].x, ns[k].y) : c.moveTo(ns[k].x, ns[k].y));
  if (close) c.closePath();
}

function tick() {
  clock++;
  if (phase === 'search') {
    const per = Math.max(8, Math.ceil(lanes[0].total / 230));
    lanes.forEach(L => {
      for (let k = 0; k < per && !L.done; k++) propose(L);
      if (!L.histDone) {
        L.hist.push({ x: L.iter, y: L.cur });
        if (L.done) L.histDone = true;
        else {
          L.gx.save();
          L.gx.lineJoin = 'round';
          L.gx.lineWidth = 1.1;
          L.gx.strokeStyle = L.id === 'b' ? 'rgba(240, 106, 84, 0.035)' : 'rgba(92, 225, 230, 0.02)';
          polyOn(L.gx, L.route, L.ns, true);
          L.gx.stroke();
          L.gx.restore();
        }
      }
    });
    if (lanes.every(L => L.done)) {
      phase = 'calculated';
      setStep(3);
      syncButtons();
      msg(`<b>ルート計算完了。</b>（A: ${shown(lanes[0].bestD)} ／ B: ${shown(lanes[1].bestD)}　※仮想距離）<b>「② スタート（競争開始）」</b>を押して、走らせましょう。`);
    }
  } else if (phase === 'run') {
    lanes.forEach(L => {
      if (!L.arrived) {
        L.d += SPEED;
        const tt = L.cum[L.cum.length - 1];
        if (L.d >= tt) { L.d = tt; L.arrived = true; L.rank = ++arrivals; }
        const pos = posAt(L, L.ns, L.d);
        L.trail.push({ x: pos.x, y: pos.y });
        if (L.trail.length > 26) L.trail.shift();
      }
    });
    if (lanes.every(L => L.arrived)) finishRace();
  }

  lanes.forEach(draw);
  drawGraph();
  ui();
  if (phase === 'search' || phase === 'run') raf = requestAnimationFrame(tick);
  else if (lanes.some(L => L.sparks.length > 0)) raf = requestAnimationFrame(tick);
}

function ui() {
  lanes.forEach(L => {
    const id = L.id, run = !!L.best;
    $('#d' + id).firstChild.textContent = run ? shown(L.bestD) : '—';
    $('#x' + id).textContent = run ? `試した回数: ${L.iter.toLocaleString('ja-JP')}回` : '試した回数: —';
    $('#h' + id).style.width = (id === 'b' && run && phase === 'search') ? (L.T / T0 * 100) + '%' : '0%';

    let s = 'STANDBY';
    if (phase === 'search') s = L.done ? (id === 'a' ? 'STOPPED / 計算終了' : 'COOLED / 計算終了') : 'CALCULATING...';
    else if (phase === 'calculated') s = 'ROUTE READY';
    else if (phase === 'run') s = L.arrived ? (L.rank === 1 ? '1ST ARRIVAL' : 'ARRIVED') : 'RUNNING...';
    else if (phase === 'done') {
      const diff = Math.abs(lanes[0].bestD - lanes[1].bestD);
      s = diff < 0.4 ? 'DRAW' : (L.rank === 1 ? 'WINNER / 先着' : '2ND');
    }
    $('#s' + id).textContent = s;
  });
}

function drawGraph() {
  const x = gx;
  x.fillStyle = '#080b10';
  x.fillRect(0, 0, GW, GH);
  const cw = gc.clientWidth || GW, narrow = cw < 520, fs = Math.min(26, 11 * GW / cw);
  const pl = narrow ? 58 : 62, pr = 24, pt = 16, pb = 38, pw = GW - pl - pr, ph = GH - pt - pb;

  x.strokeStyle = '#1e2936';
  x.lineWidth = 1;
  x.strokeRect(pl + 0.5, pt + 0.5, pw, ph);
  x.fillStyle = '#8494a7';
  x.font = `${fs}px ${SANS}`;
  x.textAlign = 'center';
  x.fillText(narrow ? '回数 →' : '試した回数 →', pl + pw / 2, GH - 10);
  x.save();
  x.translate(fs + 2, pt + ph / 2);
  x.rotate(-Math.PI / 2);
  x.fillText(narrow ? '下ほど短い' : 'いまのルートの長さ（下ほど短い）', 0, 0);
  x.restore();

  const A = lanes[0], B = lanes[1];
  if (!A.hist.length) {
    x.fillText(narrow ? '「① ルートを計算」で描かれます' : '「① ルートを計算」を押すと、AとBの探し方の違いが、ここに描かれます', pl + pw / 2, pt + ph / 2 + 4);
    return;
  }
  const xmax = Math.max(1, B.total);
  let ymax = -Infinity, ymin = Infinity;
  [A, B].forEach(L => L.hist.forEach(p => { if (p.y > ymax) ymax = p.y; if (p.y < ymin) ymin = p.y; }));
  if (ymax - ymin < 1) ymax = ymin + 1;
  const span = ymax - ymin;
  ymin -= span * 0.06;
  ymax += span * 0.04;
  const X = v => pl + Math.min(1, v / xmax) * pw;
  const Y = v => pt + (1 - (v - ymin) / (ymax - ymin)) * ph;

  [[A, '#5ce1e6', 1.8, 'A'], [B, '#f06a54', 1.4, 'B']].forEach(([L, col, lw, name]) => {
    x.strokeStyle = col;
    x.lineWidth = lw;
    x.lineJoin = 'round';
    x.beginPath();
    L.hist.forEach((p, i) => i ? x.lineTo(X(p.x), Y(p.y)) : x.moveTo(X(p.x), Y(p.y)));
    x.stroke();
    const last = L.hist[L.hist.length - 1];
    x.fillStyle = col;
    x.beginPath();
    x.arc(X(last.x), Y(last.y), 3.5, 0, Math.PI * 2);
    x.fill();
    if (L.histDone) {
      x.font = `500 ${fs}px ${MONO}`;
      x.textAlign = X(last.x) > pl + pw - 90 ? 'right' : 'left';
      const dx = X(last.x) > pl + pw - 90 ? -9 : 9;
      x.fillText(`${name} ${shown(last.y)}${name === 'A' && !narrow ? '（停止）' : ''}`, X(last.x) + dx, Y(last.y) + (name === 'A' ? fs + 4 : -9));
    }
  });
}

function draw(L) {
  const x = L.x, ns = nodes();
  x.fillStyle = '#080b10';
  x.fillRect(0, 0, W, H);

  x.strokeStyle = 'rgba(255, 255, 255, 0.03)';
  x.lineWidth = 1;
  x.beginPath();
  for (let g = 50; g < W; g += 50) { x.moveTo(g, 0); x.lineTo(g, H); }
  for (let g = 50; g < H; g += 50) { x.moveTo(0, g); x.lineTo(W, g); }
  x.stroke();

  x.strokeStyle = 'rgba(227, 179, 92, 0.06)';
  [120, 240, 360].forEach(r => { x.beginPath(); x.arc(base.x, base.y, r, 0, Math.PI * 2); x.stroke(); });

  if (L.id === 'b' && phase === 'search' && L.T > 1) {
    const grad = x.createRadialGradient(base.x, base.y, 40, base.x, base.y, 420);
    grad.addColorStop(0, `rgba(240, 106, 84, ${0.15 * L.T / T0})`);
    grad.addColorStop(1, 'rgba(240, 106, 84, 0)');
    x.fillStyle = grad;
    x.fillRect(0, 0, W, H);
  }

  x.drawImage(L.ghost, 0, 0, W, H);

  const live = L.best && L.best.length === ns.length;
  const running = live && (phase === 'run' || phase === 'done') && L.cum;

  if (live) {
    x.save();
    x.strokeStyle = running ? 'rgba(92, 214, 156, 0.28)' : (phase === 'search' && L.id === 'b' ? 'rgba(92, 214, 156, 0.55)' : '#5cd69c');
    x.lineWidth = running ? 1.8 : 2.6;
    x.lineJoin = 'round';
    polyOn(x, L.best, ns, true);
    x.stroke();
    x.restore();

    if (L.id === 'b' && phase === 'search') {
      x.save();
      x.setLineDash([7, 5]);
      x.lineDashOffset = -clock * 1.1;
      x.strokeStyle = 'rgba(240, 106, 84, 0.92)';
      x.lineWidth = 2.1;
      polyOn(x, L.route, ns, true);
      x.stroke();
      x.restore();
    }

    if (running) {
      x.save();
      x.strokeStyle = '#e3b35c';
      x.lineWidth = 3.2;
      x.lineJoin = 'round';
      x.beginPath();
      x.moveTo(base.x, base.y);
      let k = 0;
      while (k < L.best.length && L.cum[k + 1] <= L.d) {
        const p = ns[L.best[(k + 1) % L.best.length]];
        x.lineTo(p.x, p.y);
        k++;
      }
      const p = posAt(L, ns, L.d);
      x.lineTo(p.x, p.y);
      x.stroke();
      x.restore();
    }
  }

  for (let i = L.sparks.length - 1; i >= 0; i--) {
    const sp = L.sparks[i];
    x.strokeStyle = `rgba(92, 214, 156, ${sp.life * 0.7})`;
    x.lineWidth = 1.5;
    x.beginPath();
    x.arc(sp.x, sp.y, (1 - sp.life) * 26 + 4, 0, Math.PI * 2);
    x.stroke();
    sp.life -= 0.045;
    if (sp.life <= 0) L.sparks.splice(i, 1);
  }

  const seen = new Set();
  if (running) L.best.forEach((k, i) => { if (i && L.cum[i] <= L.d) seen.add(k); });

  for (let k = 1; k < ns.length; k++) {
    const on = seen.has(k), px = ns[k].x, py = ns[k].y;
    if (on) {
      x.strokeStyle = 'rgba(227, 179, 92, 0.38)';
      x.lineWidth = 1.2;
      x.beginPath();
      x.arc(px, py, 13, 0, Math.PI * 2);
      x.stroke();
    }
    x.beginPath();
    x.arc(px, py, on ? 6 : 4.5, 0, Math.PI * 2);
    x.fillStyle = on ? '#e3b35c' : '#eef2f6';
    x.fill();
  }

  x.save();
  x.strokeStyle = 'rgba(227, 179, 92, 0.45)';
  x.lineWidth = 1.2;
  x.beginPath();
  x.arc(base.x, base.y, 15, 0, Math.PI * 2);
  x.stroke();
  x.translate(base.x, base.y);
  x.rotate(Math.PI / 4);
  x.fillStyle = '#e3b35c';
  x.fillRect(-6.5, -6.5, 13, 13);
  x.restore();

  const cw0 = L.c.clientWidth || W, fs0 = Math.min(26, 11.5 * W / cw0);
  x.fillStyle = '#e3b35c';
  x.font = `500 ${fs0}px ${SANS}`;
  x.textAlign = 'center';
  x.fillText(cw0 < 520 ? '横浜' : '横浜（出発・帰着）', base.x, base.y + 14 + fs0);

  if (running && !L.arrived) {
    for (let i = 0; i < L.trail.length; i++) {
      const tr = L.trail[i], f = i / L.trail.length;
      x.fillStyle = `rgba(240, 106, 84, ${f * 0.45})`;
      x.beginPath();
      x.arc(tr.x, tr.y, f * 6, 0, Math.PI * 2);
      x.fill();
    }
    const p = posAt(L, ns, L.d);
    const glow = x.createRadialGradient(p.x, p.y, 2, p.x, p.y, 22);
    glow.addColorStop(0, 'rgba(255, 255, 255, 0.95)');
    glow.addColorStop(0.35, 'rgba(240, 106, 84, 0.75)');
    glow.addColorStop(1, 'rgba(240, 106, 84, 0)');
    x.fillStyle = glow;
    x.beginPath();
    x.arc(p.x, p.y, 22, 0, Math.PI * 2);
    x.fill();
    x.fillStyle = '#ffffff';
    x.beginPath();
    x.arc(p.x, p.y, 4.5, 0, Math.PI * 2);
    x.fill();
  }
}

lanes.forEach(L => L.c.addEventListener('pointerdown', e => {
  if (phase === 'search' || phase === 'run') {
    msg('計算・走行中は、家を動かせません。終わるまで待つか、「全部消す」を押してください。');
    return;
  }
  const r = L.c.getBoundingClientRect();
  const p = { x: (e.clientX - r.left) * W / r.width, y: (e.clientY - r.top) * H / r.height };
  const hit = pts.findIndex(q => dist(p, q) < 22);

  if (hit >= 0) {
    pts.splice(hit, 1);
  } else if (pts.length >= 30) {
    msg('家は最大30軒まで置けます。');
    return;
  } else if (dist(p, base) < 42 || pts.some(q => dist(p, q) < 24)) {
    msg('横浜か、ほかの家に近すぎます。少し離れた場所をクリックしてください。');
    return;
  } else {
    pts.push(p);
  }
  updatePresetButtons(null);
  reset(false);
}));

$('#calc').onclick = startCalculation;
$('#go').onclick = startRace;
$('#undo').onclick = () => {
  if (phase === 'search' || phase === 'run' || !pts.length) return;
  pts.pop();
  updatePresetButtons(null);
  reset(false);
};
$('#clr').onclick = () => {
  if (phase === 'search' || phase === 'run') return;
  pts = [];
  updatePresetButtons(null);
  reset(false);
};
document.querySelectorAll('[data-n]').forEach(b => {
  b.onclick = () => {
    if (phase === 'search' || phase === 'run') return;
    scatter(Number(b.dataset.n));
  };
});

window.addEventListener('resize', () => { lanes.forEach(draw); drawGraph(); });
scatter(14);
})();
</script>
